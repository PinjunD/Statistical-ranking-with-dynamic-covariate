   "source": [
    "# Horse racing data analysis"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "##### Data preprocessing"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Pay attention to the relative path of data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "\n",
    "file_name = 'horse_racing_data.csv'\n",
    "#file_name = 'horse_racing_data(normalized).csv'\n",
    "current_path = os.getcwd()\n",
    "data_path = current_path + '\\\\' + 'data' + '\\\\' \n",
    "df = pd.read_csv(data_path + file_name,index_col='race_id')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Drop Nan"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "#covariate_columns = ['Act. Wt.','Declar. Horse Wt.','Dr.','Win Odds']\n",
    "covariate_columns = ['Act. Wt.','Dr.','Win Odds']\n",
    "NaN_columns = covariate_columns+['Pla.']\n",
    "for covariate in NaN_columns:\n",
    "    df[covariate] = pd.to_numeric(df[covariate], errors='coerce')\n",
    "    df = df.dropna(subset=[covariate])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(231276, 12)"
      ]
     },
     "execution_count": 3,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.shape"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Select suitable matches and players"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "def delete_match(df,m_lower=0,m_upper=100):\n",
    "    df = df.copy()\n",
    "    i = 0\n",
    "    indexes = []\n",
    "    for index in df.index.unique():\n",
    "        m = df[df.index == index].shape[0]\n",
    "        if m >= m_lower and m <= m_upper:\n",
    "            i += 1\n",
    "        else:\n",
    "            indexes.append(index)\n",
    "    df = df.drop(index = indexes)\n",
    "    return df,i\n",
    "\n",
    "def delete_player(df,d_min=0,name = 'Horse'):\n",
    "    counts = df[name].value_counts()\n",
    "    values_to_keep = counts[counts >= d_min].index\n",
    "    df = df[df[name].isin(values_to_keep)]\n",
    "    return df,len(values_to_keep)\n",
    "\n",
    "def select(df,m_lower=0,m_upper=100,d_min=0,name = 'Horse'):\n",
    "    NN = len(df.index.unique())\n",
    "    nn = len(df[name].value_counts())\n",
    "    change = True\n",
    "    while change:\n",
    "        print('-'*10)\n",
    "        print(f'The number of matches: {NN}')\n",
    "        print(f'The number of horses: {nn}')\n",
    "        df,N = delete_match(df,m_lower,m_upper)\n",
    "        df,n = delete_player(df,d_min)\n",
    "        if NN == N and nn == n:\n",
    "            change = False\n",
    "        else:\n",
    "            NN = N\n",
    "            nn = n\n",
    "    return df,n,N"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
