   "source": [
    "m_lower = 4\n",
    "m_upper = 14\n",
    "d_min = 10\n",
    "df,n,N = select(df,m_lower,m_upper,d_min)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "Normalization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Actual Weight\n",
    "df['Act. Wt.'] = np.log(df['Act. Wt.'])\n",
    "mean_A = df['Act. Wt.'].mean()\n",
    "std_A = df['Act. Wt.'].std()\n",
    "df['Act. Wt.'] = (df['Act. Wt.'] - mean_A) / std_A\n",
    "# Draw\n",
    "df['Dr.']\n",
    "for index in df.index.unique():\n",
    "    df.loc[index,'Dr.'] = pd.Series(df.loc[index,'Dr.']/max(df.loc[index,'Dr.'])).astype(float)\n",
    "# Belief\n",
    "for index in df.index.unique():\n",
    "    t = df.loc[index,'Win Odds']\n",
    "    df.loc[index,'Win Odds'] = np.log((1 / t) / np.sum(1 / t))"
   ]
  },
